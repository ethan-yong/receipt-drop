# Copy to supabase/functions/.env for local edge function secrets.
# Do not put SUPABASE_* vars here — the CLI injects those automatically.

# Base URL only — ocr-proxy appends /ocr, enrich-transaction appends
# /understand (the LLM receipt-understanding step — the LLM gateway itself is
# only ever called from services/ocr-api, configured via VLLM_* in the ROOT
# .env, not here; see docs/decisions.md). Use host.docker.internal so the
# edge runtime container can reach uvicorn on the host (not localhost).
OCR_SERVICE_URL=http://host.docker.internal:8081
OCR_SERVICE_SECRET=your-local-ocr-secret

# Only needed in production, where OCR_SERVICE_URL points at
# https://ocr.receipt-drop.org and Cloudflare Access gates that hostname
# (Service Token) on top of X-OCR-Secret. Leave unset for local dev — ocr-api
# isn't behind Access there, so ocr-proxy/enrich-transaction skip these
# headers entirely when either is missing. See docs/decisions.md.
# CF_ACCESS_CLIENT_ID=your-service-token-client-id
# CF_ACCESS_CLIENT_SECRET=your-service-token-client-secret

# payment-notification-proxy's own inbound auth (verify_jwt=false for this
# one function — see supabase/config.toml). Not a Supabase JWT: this is a
# single shared secret the native Android app sends as
# X-Payment-Notification-Secret, checked in
# _shared/payment_notification_auth.ts. Must match the value baked into the
# Android build via android/local.properties'
# PAYMENT_NOTIFICATION_PROXY_SECRET. See docs/system/decisions.md for why.
PAYMENT_NOTIFICATION_PROXY_SECRET=your-local-payment-notification-secret

# GOOGLE_PLACES_API_KEY is required by enrich-transaction and places-proxy
# but deliberately not templated here — set it directly in this local .env
# (never commit it) or via `supabase secrets set` for deployed environments.
# GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Merchant-intelligence brand/location reconciliation (enrich-transaction).
# "off" (default, safe): no candidate lookups, no reconcile_merchant_resolution
# calls, no extra logging. "shadow": scores a decision and logs it, but never
# writes. "on": also calls reconcile_merchant_resolution to persist the
# decision. Unset or any other value is treated as "off".
MERCHANT_INTELLIGENCE_MODE=off

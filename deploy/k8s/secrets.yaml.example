# Copy this file to `secrets.yaml` (same directory) and fill in real values.
# `secrets.yaml` is gitignored — never commit it. deploy.ps1 refuses to run
# if it's missing.
#
# Only env vars the code actually reads are listed here — see
# services/ocr-api/app/{auth,receipt_understanding}.py and
# services/leaderboard-api/app/{auth,db,cache}.py for the source of truth.

apiVersion: v1
kind: Secret
metadata:
  name: ocr-api-secrets
  namespace: receipt-drop
type: Opaque
stringData:
  # Shared-secret header (X-OCR-Secret) checked against the ocr-proxy Edge
  # Function and enrich-transaction's OCR_SERVICE_SECRET — must match.
  OCR_SHARED_SECRET: "change-me"

  # vllm | deepseek — selects which block below is used.
  LLM_PROVIDER: "vllm"

  # LiteLLM / vLLM gateway (LLM_PROVIDER=vllm). Must be reachable from
  # ubuntu-ethan's network (LAN gateways are not reachable from Supabase's
  # hosted cloud, but ocr-api runs on your own VM so this is fine as long as
  # the VM has line-of-sight to the gateway host).
  VLLM_BASE_URL: "http://192.168.2.134:31180/v1"
  VLLM_MODEL_NAME: "local/vllm/openai/gpt-oss-20b"
  VLLM_API_KEY: "sk-your-litellm-virtual-key"
  VLLM_REASONING_EFFORT: "low"

  # DeepSeek OpenAI-compatible API (LLM_PROVIDER=deepseek) — leave blank if
  # using vllm above.
  DEEPSEEK_BASE_URL: "https://api.deepseek.com/v1"
  DEEPSEEK_MODEL_NAME: "deepseek-chat"
  DEEPSEEK_API_KEY: "sk-your-deepseek-key"
---
apiVersion: v1
kind: Secret
metadata:
  name: leaderboard-api-secrets
  namespace: receipt-drop
type: Opaque
stringData:
  # Supabase Postgres connection string — the production project's, not the
  # local 127.0.0.1:54322 dev value. leaderboard-api impersonates the
  # caller's JWT over this connection so Postgres RLS applies.
  DATABASE_URL: "postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

  # From `supabase status` (local) or the hosted project's JWT secret
  # (Supabase dashboard -> Settings -> API) for production.
  SUPABASE_JWT_SECRET: "change-me"

  # Not sensitive (no auth configured on the in-cluster Redis), kept here
  # alongside the rest for one-file simplicity. Matches deploy/k8s/redis.yaml's
  # Service name.
  REDIS_URL: "redis://redis-service:6379/0"

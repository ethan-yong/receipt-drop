# Copy this file to `.env` at the repo root so Flutter can bundle it as an asset in debug/dev.
# (The real `.env` is gitignored — never commit secrets.)

# Local: `supabase start` then `supabase status` → Publishable key + API URL.
# Physical Android: run `.\scripts\android_dev_ports.ps1` so 127.0.0.1 reaches your PC.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=sb_publishable_YOUR_LOCAL_PUBLISHABLE_KEY

# Optional: Redis-backed friends leaderboard API (see README).
LEADERBOARD_API_URL=http://localhost:8080

# Leaderboard API + docker compose (not used by Flutter directly).
SUPABASE_JWT_SECRET=your-local-jwt-secret-from-supabase-status
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
REDIS_URL=redis://localhost:6379/0

# Debug: skip onboarding + sign-in. Omit this line or use true while building features.
SKIP_AUTH=true

# Self-hosted OCR API — used by `uv run ocr-api`, batch scripts, and Flutter debug OCR.
# Must match OCR_SERVICE_SECRET in supabase/functions/.env (copy from .env.example there).
OCR_SHARED_SECRET=your-local-ocr-secret
# Flutter debug: call OCR API directly (skips ocr-proxy). Emulator: http://10.0.2.2:8081/ocr
OCR_API_URL=http://127.0.0.1:8081/ocr

# Optional OCR API dev server (uv run ocr-api). Default port 8081.
# OCR_API_PORT=8081
# OCR_API_HOST=0.0.0.0
# OCR_API_RELOAD=true

# Google OAuth (Web application client). Used by scripts/supabase_start.ps1 for local Supabase.
GOOGLE_OAUTH_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-web-client-secret

MAPS_API_KEY=your-android-key-here

# LiteLLM / vLLM gateway — probed by scripts/inspect_llm_endpoint.py, and
# required by services/ocr-api's POST /understand (LLM receipt-understanding
# step, called by enrich-transaction; see docs/decisions.md). Not needed for
# /ocr itself or for any Supabase edge function directly.
# VLLM_BASE_URL=http://192.168.2.134:31180/v1
# VLLM_API_KEY=sk-your-litellm-virtual-key
# VLLM_MODEL_NAME=local/vllm/openai/gpt-oss-20b
# VLLM_REASONING_EFFORT=low
# Copy this file to `.env` at the repo root so Flutter can bundle it as an asset in debug/dev.
# (The real `.env` is gitignored — never commit secrets.)

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Debug: skip onboarding + sign-in (default true in debug). Set false to test auth UI.
# SKIP_AUTH=true
